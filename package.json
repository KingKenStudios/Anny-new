{
  "name": "anny-workspace",
  "private": true,
  "version": "3.0.0",
  "description": "ANNY — Intelligence by Akinwumi Group (AI Studio & Node.js root workspace)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx primary-anny/Anny/server.ts",
    "build": "vite build && esbuild primary-anny/Anny/server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test primary-anny/Anny/src/services/*.test.ts primary-anny/Anny/src/vision/*.test.ts primary-anny/Anny/src/creative/*.test.ts",
    "test:creative": "tsx --test primary-anny/Anny/src/creative/*.test.ts",
    "test:vision": "tsx --test primary-anny/Anny/src/vision/*.test.ts",
    "test:storage": "tsx --test primary-anny/Anny/src/services/minioStorage.test.ts",
    "test:auth": "tsx --test primary-anny/Anny/src/services/authSecurityPlatform.test.ts",
    "test:security": "tsx --test primary-anny/Anny/src/services/uploadPolicy.test.ts primary-anny/Anny/src/services/authSecurityPlatform.test.ts primary-anny/Anny/src/services/postgresPlatform.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@babel/standalone": "^8.1.3",
    "@google/genai": "^3.6.1",
    "@google/model-viewer": "^4.4.0",
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/drawing_utils": "^0.3.1675466124",
    "@mediapipe/pose": "^0.5.1675469404",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "amqplib": "^2.4.1",
    "axios": "^1.21.1",
    "buffer": "^6.0.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "firebase": "^13.4.0",
    "form-data": "^4.0.6",
    "html2canvas": "^1.4.1",
    "ioredis": "^6.0.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.11.0",
    "stripe": "^23.2.0",
    "tailwind-merge": "^3.7.1",
    "three": "^0.183.0",
    "ws": "^8.23.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.183.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
