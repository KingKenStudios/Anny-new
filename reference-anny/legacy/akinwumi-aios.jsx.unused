/* ============================== HARDWARE ============================== */

const PROCESSES = [["inference-server", "34%", "2.1GB"], ["vector-indexer", "12%", "890MB"], ["automation-worker", "8%", "410MB"]];
const CONTAINERS = [{ name: "inference-node-01", status: T.mint }, { name: "inference-node-04", status: T.coral }, { name: "worker-pool-a", status: T.mint }];

function Hardware() {
  const [live, setLive] = useState({ cpu: 34, gpu: 71, ram: 58, disk: 22, temp: 62 });
  useEffect(() => { const id = setInterval(() => setLive((l) => ({ cpu: clamp(l.cpu + rand()), gpu: clamp(l.gpu + rand()), ram: clamp(l.ram + rand()), disk: clamp(l.disk + rand()), temp: Math.max(40, Math.min(85, l.temp + rand())) })), 1500); return () => clearInterval(id); }, []);
  function rand() { return Math.random() * 6 - 3; }
  return (
    <div style={{ padding: "0 24px 24px", display: "flex", flexDirection: "column", gap: 16 }}>
      <SectionHeader icon={HardDrive} title="Hardware" subtitle="Live infrastructure monitoring across the inference fleet." />
      <div style={{ display: "grid", gridTemplateColumns: "repeat(5, 1fr)", gap: 12 }}>
        <Stat label="CPU" value={`${Math.round(live.cpu)}%`} icon={Cpu} color={T.violet} />
        <Stat label="GPU" value={`${Math.round(live.gpu)}%`} icon={HardDrive} color={T.aurum} />
        <Stat label="Memory" value={`${Math.round(live.ram)}%`} icon={Layers} color={T.mint} />
        <Stat label="Disk I/O" value={`${Math.round(live.disk)}%`} icon={Database} color={T.mist} />
        <Stat label="Temperature" value={`${Math.round(live.temp)}°C`} icon={Thermometer} color={T.amber} />
      </div>
      <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12 }}>
        <Panel title="Top processes" icon={Activity}><MiniTable columns={["Process", "CPU", "Memory"]} rows={PROCESSES} /></Panel>
        <Panel title="Containers" icon={Container}>
          {CONTAINERS.map((c, i) => (
            <Row key={c.name} first={i === 0}><span style={{ fontSize: 12.5, display: "flex", alignItems: "center", gap: 7 }}><Container size={13} color={T.mistDim} />{c.name}</span><span style={{ width: 7, height: 7, borderRadius: "50%", background: c.status }} /></Row>
          ))}
        </Panel>
      </div>
    </div>
  );
}

/* ============================== LOGS ============================== */

const LOG_LINES = [
  { sev: "info", t: "13:02:41", src: "inference-server", msg: "Request handled in 84ms" },
  { sev: "warn", t: "13:02:38", src: "worker-pool-a", msg: "Queue depth exceeded 500" },
  { sev: "error", t: "13:02:20", src: "inference-node-04", msg: "OOM kill — restarting container" },
  { sev: "info", t: "13:01:58", src: "automation-engine", msg: "Workflow invoice-triage run #341 completed" },
  { sev: "info", t: "13:01:40", src: "vector-indexer", msg: "Indexed 1,204 new embeddings" },
];
const SEV_COLOR = { info: T.mist, warn: T.amber, error: T.coral };

function Logs() {
  const [filter, setFilter] = useState("all");
  const rows = filter === "all" ? LOG_LINES : LOG_LINES.filter((l) => l.sev === filter);
  return (
    <div style={{ padding: "0 24px 24px", display: "flex", flexDirection: "column", gap: 16 }}>
      <SectionHeader icon={ScrollText} title="Logs" subtitle="Streaming logs across every service, searchable and filterable."
        right={<QuickActions items={[{ label: "Export", icon: Download }, { label: "Save view", icon: BookMarked }]} />} />
      <div style={{ display: "flex", gap: 8 }}>
        {["all", "info", "warn", "error"].map((f) => (
          <button key={f} onClick={() => setFilter(f)} style={{ fontSize: 11.5, padding: "5px 11px", borderRadius: 7, border: `1px solid ${T.line}`, background: filter === f ? T.elevated : "transparent", color: filter === f ? T.bone : T.mistDim, cursor: "pointer", textTransform: "capitalize" }}>{f}</button>
        ))}
      </div>
      <Panel noPad>
        <div style={{ fontFamily: "'JetBrains Mono', monospace", fontSize: 12, padding: "10px 4px" }}>
          {rows.map((l, i) => (
            <div key={i} style={{ display: "flex", gap: 12, padding: "5px 16px", borderTop: i > 0 ? `1px solid ${T.lineSoft}` : "none" }}>
              <span style={{ color: T.mistDim, flexShrink: 0 }}>{l.t}</span>
              <span style={{ color: SEV_COLOR[l.sev], width: 46, flexShrink: 0, textTransform: "uppercase", fontSize: 10.5 }}>{l.sev}</span>
              <span style={{ color: T.aurumDim, flexShrink: 0, width: 140, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{l.src}</span>
              <span style={{ color: T.mist }}>{l.msg}</span>
            </div>
          ))}
        </div>
      </Panel>
      <Panel title="Log volume" icon={BarChart3}>
        <div style={{ height: 80 }}>
          <ResponsiveContainer width="100%" height="100%"><BarChart data={spark(20, 30)}><Bar dataKey="v" fill={T.violet} radius={[2, 2, 0, 0]} /></BarChart></ResponsiveContainer>
        </div>
      </Panel>
    </div>
  );
}

/* ============================== SETTINGS ============================== */

const SETTINGS_SECTIONS = [
  { id: "profile", label: "Profile", icon: User },
  { id: "workspace", label: "Workspace", icon: Boxes },
  { id: "security", label: "Security", icon: ShieldCheck },
  { id: "billing", label: "Billing", icon: CreditCard },
  { id: "notifications", label: "Notifications", icon: BellIcon },
  { id: "appearance", label: "Appearance", icon: Palette },
  { id: "keys", label: "API keys", icon: Braces },
  { id: "shortcuts", label: "Shortcuts", icon: Keyboard },
];

function SettingsPage() {
  const [sec, setSec] = useState("profile");
  const [toggles, setToggles] = useState({ email: true, push: false, weekly: true });
  return (
    <div style={{ display: "flex", height: "100%" }}>
      <div style={{ width: 200, borderRight: `1px solid ${T.line}`, padding: 14, flexShrink: 0 }}>
        <div style={{ fontFamily: "'Space Grotesk', sans-serif", fontSize: 15, fontWeight: 600, marginBottom: 12 }}>Settings</div>
        {SETTINGS_SECTIONS.map((s) => (
          <div key={s.id} onClick={() => setSec(s.id)} style={{ display: "flex", alignItems: "center", gap: 9, padding: "8px 9px", borderRadius: 7, cursor: "pointer", background: sec === s.id ? T.elevated : "transparent", color: sec === s.id ? T.bone : T.mist, fontSize: 12.5, marginBottom: 2 }}>
            <s.icon size={14} /> {s.label}
          </div>
        ))}
      </div>
      <div style={{ flex: 1, padding: 24, overflowY: "auto" }}>
        {sec === "notifications" ? (
          <Panel title="Notification preferences" icon={BellIcon}>
            {[["email", "Email notifications"], ["push", "Push notifications"], ["weekly", "Weekly digest"]].map(([k, label]) => (
              <Row key={k} first={k === "email"}>
                <span style={{ fontSize: 13 }}>{label}</span>
                <Toggle on={toggles[k]} onClick={() => setToggles((t) => ({ ...t, [k]: !t[k] }))} />
              </Row>
            ))}
          </Panel>
        ) : sec === "appearance" ? (
          <Panel title="Appearance" icon={Palette}>
            <div style={{ display: "flex", gap: 10 }}>
              {[{ l: "Dark", i: Moon, on: true }, { l: "Light", i: Sun, on: false }].map((o) => (
                <div key={o.l} style={{ display: "flex", alignItems: "center", gap: 6, padding: "8px 14px", borderRadius: 8, border: `1px solid ${o.on ? T.aurum : T.line}`, color: o.on ? T.aurum : T.mist, fontSize: 12.5 }}><o.i size={13} />{o.l}</div>
              ))}
            </div>
          </Panel>
        ) : sec === "keys" ? (
          <Panel title="API keys" icon={Braces} actions={<QuickActions items={[{ label: "New key", icon: Plus }]} />}>
            <MiniTable columns={["Name", "Prefix", "Created", "Last used"]} rows={[["Production", "sk-live-••••", "Jan 12", "2m ago"], ["Staging", "sk-test-••••", "Feb 3", "1h ago"]]} />
          </Panel>
        ) : (
          <Panel title={SETTINGS_SECTIONS.find((s) => s.id === sec)?.label} icon={SETTINGS_SECTIONS.find((s) => s.id === sec)?.icon}>
            <div style={{ fontSize: 12.5, color: T.mistDim }}>This section follows the same design system — wire it to your real account, auth, and billing data.</div>
          </Panel>
        )}
      </div>
    </div>
  );
}

function Toggle({ on, onClick }) {
  return (
    <div onClick={onClick} style={{ width: 34, height: 19, borderRadius: 10, background: on ? T.aurum : T.elevated, border: `1px solid ${on ? T.aurum : T.line}`, cursor: "pointer", position: "relative", transition: "background 150ms" }}>
      <motion.div animate={{ x: on ? 15 : 1 }} transition={{ duration: 0.15 }} style={{ width: 15, height: 15, borderRadius: "50%", background: on ? T.void : T.mist, position: "absolute", top: 1 }} />
    </div>
  );
}

/* ============================== COMMAND PALETTE ============================== */

const PALETTE_ACTIONS = NAV.map((n) => ({ id: n.id, label: `Go to ${n.label}`, icon: n.icon }));

function CommandPalette({ onClose, onNavigate }) {
  const [q, setQ] = useState("");
  const filtered = PALETTE_ACTIONS.filter((a) => a.label.toLowerCase().includes(q.toLowerCase()));
  return (
    <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }} onClick={onClose} style={{ position: "absolute", inset: 0, background: "rgba(5,6,9,0.6)", zIndex: 50, display: "flex", alignItems: "flex-start", justifyContent: "center", paddingTop: 100, borderRadius: 14 }}>
      <motion.div initial={{ opacity: 0, y: -10, scale: 0.97 }} animate={{ opacity: 1, y: 0, scale: 1 }} exit={{ opacity: 0, y: -10, scale: 0.97 }} transition={{ duration: 0.16 }}
        onClick={(e) => e.stopPropagation()} style={{ width: 420, background: T.panel, border: `1px solid ${T.line}`, borderRadius: 12, boxShadow: "0 20px 60px rgba(0,0,0,0.5)", overflow: "hidden" }}>
        <div style={{ display: "flex", alignItems: "center", gap: 10, padding: "12px 14px", borderBottom: `1px solid ${T.lineSoft}` }}>
          <Command size={14} color={T.aurum} />
          <input autoFocus value={q} onChange={(e) => setQ(e.target.value)} placeholder="Jump to a module, action, or search…" style={{ flex: 1, background: "transparent", border: "none", outline: "none", color: T.bone, fontSize: 13.5 }} />
          <X size={14} color={T.mistDim} style={{ cursor: "pointer" }} onClick={onClose} />
        </div>
        <div style={{ padding: 6, maxHeight: 280, overflowY: "auto" }}>
          {filtered.map((a) => {
            const Icon = a.icon;
            return (
              <div key={a.id} onClick={() => onNavigate(a.id)} style={{ display: "flex", alignItems: "center", gap: 10, padding: "9px 10px", borderRadius: 8, cursor: "pointer", fontSize: 13 }}
                onMouseEnter={(e) => (e.currentTarget.style.background = T.elevated)} onMouseLeave={(e) => (e.currentTarget.style.background = "transparent")}>
                <Icon size={14} color={T.mist} />{a.label}<ArrowUpRight size={12} color={T.mistDim} style={{ marginLeft: "auto" }} />
              </div>
            );
          })}
          {filtered.length === 0 && <div style={{ padding: 14, fontSize: 12.5, color: T.mistDim }}>No matches.</div>}
        </div>
      </motion.div>
    </motion.div>
  );
}

/* ============================== FONTS ============================== */

function GlobalFonts() {
  return (
    <style>{`
      @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap');
      @keyframes pulse-dot { 0%, 60%, 100% { opacity: 0.3; transform: translateY(0); } 30% { opacity: 1; transform: translateY(-2px); } }
      @keyframes blink { 0%, 50% { opacity: 1; } 51%, 100% { opacity: 0; } }
      ::-webkit-scrollbar { width: 8px; height: 8px; }
      ::-webkit-scrollbar-thumb { background: ${T.line}; border-radius: 4px; }
      ::-webkit-scrollbar-track { background: transparent; }
      textarea::placeholder, input::placeholder { color: ${T.mistDim}; }
    `}</style>
  );
}
