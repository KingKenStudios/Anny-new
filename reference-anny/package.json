{
  "name": "anny-robot-consciousness",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist build",
    "lint": "tsc --noEmit",
    "modly:setup": "cd modly-main/api && python3 -m venv .venv && . .venv/bin/activate && pip install -r requirements.txt",
    "modly:start": "cd modly-main/api && . .venv/bin/activate && python3 -m uvicorn main:app --host 127.0.0.1 --port 8765"
  },
  "dependencies": {
    "@babel/standalone": "^8.0.4",
    "@google/genai": "^3.6.1",
    "@google/model-viewer": "^4.2.0",
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/drawing_utils": "^0.3.1675466124",
    "@mediapipe/pose": "^0.5.1675469404",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@stripe/stripe-js": "^9.4.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^5.2.0",
    "amqplib": "^2.0.1",
    "axios": "^1.16.0",
    "buffer": "^6.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "firebase": "^12.12.1",
    "form-data": "^4.0.5",
    "html2canvas": "1.4.1",
    "ioredis": "^6.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "minio": "^8.0.7",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "stripe": "^22.1.0",
    "three": "^0.183.0",
    "tsx": "^4.21.0",
    "vite": "^6.4.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/babel__standalone": "^7.1.9",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^5.0.0",
    "@types/minio": "^7.1.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.8.2"
  }
}
