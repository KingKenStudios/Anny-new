# ==============================================================================
# ANNY — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and populate values for your deployment environment.
# NEVER commit real secrets, API keys, or credentials to version control.
# ==============================================================================

# --- Runtime & Server ---
NODE_ENV=development
APP_NAME=ANNY
APP_URL=http://localhost:3000
PORT=3000
TRUST_PROXY=false
ALLOWED_ORIGINS=
# Execution policy: HYBRID_DEFAULT | OFFLINE_ONLY | ONLINE_PREFERRED
ANNY_EXECUTION_MODE=HYBRID_DEFAULT

# --- Mandatory Security Secrets (Required in production; >= 32 random chars) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=

# --- Administrator Verification (Optional; server-side only) ---
ADMIN_USERNAME=
# Prefer PBKDF2 v2 hash generated by authSecurityPlatform.hashPassword()
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
# Comma-separated verified Firebase admin emails
ADMIN_EMAILS=

# --- AI Providers (Server-side only; never expose to browser bundles) ---
GEMINI_API_KEY=
GOOGLE_AI_STUDIO_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=

# --- Optional Local Models & Bridges (Self-hosted; not required in AI Studio) ---
OLLAMA_BASE_URL=
SD_WEBUI_URL=
WAZOBIA_TTS_URL=
MODLY_LOCAL_URL=
MODLY_API_KEY=
MESHY_API_KEY=

# --- Optional Object Storage (S3 / MinIO via AWS SDK v3) ---
# Explicit endpoint and non-default credentials required; 'minioadmin' is rejected.
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_BUCKET=anny-artifacts
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Optional Enterprise Databases & Infrastructure (Self-hosted) ---
DATABASE_URL=
ANNY_REQUIRE_DURABLE_PERSISTENCE=false
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
QDRANT_URL=
QDRANT_API_KEY=
RABBITMQ_URL=
CLICKHOUSE_URL=

# --- Optional Firebase / Payments / Integrations ---
FIREBASE_PROJECT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLIC_KEY=
KEDA_API_URL=
KEDA_API_TOKEN=
KEDA_ALLOWED_ACTIONS=

# --- Hardware & Mode Flags ---
ANNY_HARDWARE=false
VITE_USER_ONLY_MODE=false